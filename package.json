{
  "name": "pi-web-access-desktop",
  "version": "0.2.1",
  "private": true,
  "type": "commonjs",
  "description": "PI-Desktop plugin that ports nicobailon/pi-web-access web search and page fetching to the desktop plugin system.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobailon/pi-web-access.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test \"test/*.test.js\"",
    "test:adapter": "node scripts/build.mjs && node --test \"test/adapter.test.js\"",
    "test:config": "node scripts/build.mjs && node --test \"test/config.test.js\"",
    "test:view": "node --test \"test/view.test.js\"",
    "test:upstream": "node scripts/test-upstream.mjs",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "smoke": "node scripts/build.mjs && node scripts/smoke.mjs",
    "pack": "node scripts/build.mjs && node scripts/pack.mjs",
    "devkit:check": "node scripts/devkit-check.mjs",
    "gen:port-notes": "node scripts/gen-port-notes.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "^0.6.0",
    "defuddle": "0.19.3",
    "linkedom": "^0.16.0",
    "p-limit": "^6.1.0",
    "promise.try": "^2.0.1",
    "turndown": "^7.2.0",
    "typebox": "1.3.27",
    "undici": "^8.11.2",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
